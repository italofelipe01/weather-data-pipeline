# Copie para .env (ignorado pelo git) e preencha a chave da OpenWeather.
# Usado por scripts/test-openweather-local.ps1, scripts/run-local-pipeline.ps1 e scripts/deploy.ps1
# (que cria o parametro SSM a partir daqui no primeiro deploy).
AWS_REGION=sa-east-1
STACK_NAME=weather-data-pipeline-dev
ENVIRONMENT=dev
OPENWEATHER_UNITS=metric
OPENWEATHER_LANG=pt_br
OPENWEATHER_PRODUCTS=current_weather
OPENWEATHER_API_KEY=SUA_API_KEY_AQUI
OPENWEATHER_API_KEY_PARAMETER_NAME=/weather-data-pipeline/dev/openweather-api-key
