# ==========================================
# CONFIGURAÇÕES DO PROJETO
# ==========================================
COMPOSE_PROJECT_NAME=weather_pipeline
AIRFLOW_PROJ_DIR=.

# ==========================================
# AIRFLOW
# ==========================================
AIRFLOW_UID=50000
AIRFLOW_GID=0

# Credenciais do Airflow Web UI
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# Fernet Key (gerar com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
AIRFLOW__CORE__FERNET_KEY=your_fernet_key_here

# ==========================================
# POSTGRESQL
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=strong_password_here_change_me
POSTGRES_DB=weather_db

# ==========================================
# SUPERSET
# ==========================================
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=admin
# Secret Key (gerar com: python -c "import secrets; print(secrets.token_urlsafe(32))")
SUPERSET_SECRET_KEY=your_superset_secret_key_here

# ==========================================
# PGADMIN (OPCIONAL)
# ==========================================
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin

# ==========================================
# API KEYS
# ==========================================
# OpenWeatherMap API Key (obter em: https://openweathermap.org/api)
OPENWEATHER_API_KEY=your_api_key_here

# ==========================================
# NOTIFICAÇÕES (OPCIONAL)
# ==========================================
# Slack Webhook URL (obter em: https://api.slack.com/messaging/webhooks)
SLACK_WEBHOOK_URL=

# ==========================================
# AMBIENTE
# ==========================================
ENVIRONMENT=development